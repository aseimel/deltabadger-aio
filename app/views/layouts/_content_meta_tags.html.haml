/ Essential META Tags
%meta{:content => content_for?(:title) ? yield(:title) : t('meta.title_short'), :property => "og:title"}
%meta{:content => content_for?(:title) ? yield(:title) : t('meta.title_short'), :name => "twitter:title"}
%meta{:content => content_for?(:meta_description) ? yield(:meta_description) : t('meta.descriptions.default'), :name => "description"}
%meta{:content => content_for?(:meta_description) ? yield(:meta_description) : t('meta.descriptions.default'), :property => "og:description"}
%meta{:content => content_for?(:meta_description) ? yield(:meta_description) : t('meta.descriptions.default'), :name => "twitter:description"}

%meta{:content => "https://#{request.host}/", :property => "og:url"}
%meta{:content => "summary", :name => "twitter:card"}

%meta{:content => t('meta.title'), :property => "og:site_name"}
%meta{:content => "product", :property => "og:type"}
