<%= form_with model: bot,
              url: path,
              method: method,
              class: "widget #{bot.adaptive_dca_enabled? ? "bot-settings--active" : "bot-settings--inactive"}",
              data: {
                controller: "class-toggle form--submit form--submit-after-delay form--html5-validations",
                class_toggle_target: "togglable",
                class_toggle_toggle_classes_value: ["bot-settings--active", "bot-settings--inactive"],
                turbo_stream: true
              } do |f| %>
  <div class="toggle-group">
    <div class="toggle">
      <%= f.check_box :adaptive_dca_enabled, data: { action: "change->form--submit#submit change->class-toggle#toggle" }, disabled: bot.working? %>
      <div class="toggle__style"></div>
    </div>
    <div class="toggle-group__info">
      <div class="toggle-group__info__label">
        <%= f.label :adaptive_dca_enabled, class: "conversational conversational--small conversational--disabled" do %>
          <%= t("bot.adaptive_dca.label") %>
        <% end %>
      </div>
      <% if bot.adaptive_dca_enabled? %>
        <div class="adaptive-dca-settings">
          <small><%= t("bot.adaptive_dca.hourly_note") %></small>
          <div class="adaptive-dca-settings__row">
            <span><%= t("bot.adaptive_dca.aggressiveness") %></span>
            <%= f.select :adaptive_dca_aggressiveness,
                  Bot::AdaptiveDcaable::ADAPTIVE_DCA_AGGRESSIVENESS_LEVELS.keys.map { |k| [t("bot.adaptive_dca.#{k}"), k] },
                  { selected: bot.adaptive_dca_aggressiveness },
                  class: "sinput sinput--select",
                  data: { action: "change->form--submit#submit" },
                  disabled: bot.working? %>
          </div>
          <div class="adaptive-dca-settings__row">
            <span><%= t("bot.adaptive_dca.floor") %></span>
            <%= f.number_field :adaptive_dca_floor_pct,
                  value: bot.adaptive_dca_floor_pct,
                  class: 'sinput numeric-input',
                  step: 1,
                  min: 1,
                  max: 100,
                  size: 2,
                  data: { controller: "autowidth-input",
                          action: "input->form--submit-after-delay#submit input->autowidth-input#resize",
                          form__move_cursor_to_end_target: "input" },
                  style: "margin-left: 0.125rem; width: 50px;",
                  disabled: bot.working? %> %
          </div>
          <div class="adaptive-dca-settings__row">
            <span><%= t("bot.adaptive_dca.ceiling") %></span>
            <%= f.number_field :adaptive_dca_ceiling_pct,
                  value: bot.adaptive_dca_ceiling_pct,
                  class: 'sinput numeric-input',
                  step: 1,
                  min: 101,
                  max: 500,
                  size: 2,
                  data: { controller: "autowidth-input",
                          action: "input->form--submit-after-delay#submit input->autowidth-input#resize",
                          form__move_cursor_to_end_target: "input" },
                  style: "margin-left: 0.125rem; width: 50px;",
                  disabled: bot.working? %> %
          </div>
          <div class="adaptive-dca-settings__row">
            <label>
              <%= f.check_box :adaptive_dca_reset, data: { action: "change->form--submit#submit" }, disabled: bot.working? %>
              <%= t("bot.adaptive_dca.reset") %>
            </label>
          </div>
        </div>
        <% multiplier = bot.adaptive_multiplier %>
        <% baseline_hourly = bot.quote_amount.to_f / 24.0 %>
        <% effective_hourly = baseline_hourly * multiplier %>
        <% cold_start = bot.adaptive_dca_cold_start? %>
        <div class="adaptive-dca-status">
          <small>
            <span class="adaptive-dca-status__multiplier <%= multiplier >= 1 ? 'text-success' : 'text-danger' %>">
              <%= number_with_precision(multiplier, precision: 2) %>&times;
            </span>
            <%= t("bot.adaptive_dca.effective_rate",
                  amount: number_with_precision(effective_hourly, precision: 2),
                  baseline: number_with_precision(baseline_hourly, precision: 2),
                  quote: bot.quote_asset.symbol) %>
            <br/>
            <% if cold_start %>
              <span class="text-muted"><%= t("bot.adaptive_dca.calibrating") %></span>
            <% else %>
              <%= t("bot.adaptive_dca.belief_price",
                    price: number_with_precision(bot.blended_mu, precision: 2),
                    quote: bot.quote_asset.symbol) %>
            <% end %>
          </small>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
