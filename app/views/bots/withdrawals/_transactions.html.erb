<div class="widget widget--table">
  <table class="table">
    <thead>
      <tr>
        <th scope="col"><%= t('data_labels.date') %></th>
        <th scope="col"><%= t('data_labels.amount') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody id="orders_list">
      <% if bot.transactions.where.not(status: :skipped).none? %>
        <tr id="orders_list_placeholder">
          <td colspan="3" class="text-center text-inactive" style="padding: 3rem 2rem;">
            <%= t('bot.messages.no_withdrawals_yet') %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= turbo_frame_tag 'orders_pagination', src: bot_path(bot, format: :turbo_stream), loading: :lazy %>
</div>
<%= render 'bots/orders/export', bot: bot %>
